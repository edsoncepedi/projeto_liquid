# ===========================================================================
# Variaveis de ambiente - execucao SEM Docker
# ===========================================================================
# Copie para .env e ajuste:   cp .env.example .env
#
# No Docker NAO use este arquivo: as variaveis dos containers estao definidas
# em docker-compose.yml (o compose so leria .env para substituir ${VAR}, e o
# arquivo nao usa nenhuma). Um .env presente nao afeta os containers.
# ===========================================================================

# ---------------------------------------------------------------------------
# Simulador de CLP
# ---------------------------------------------------------------------------
SIMULATOR_MODBUS_HOST=0.0.0.0     # onde o servidor Modbus do simulador escuta
SIMULATOR_MODBUS_PORT=5020
WEB_HOST=0.0.0.0
WEB_PORT=8080
SIMULATOR_TITLE=TESTE LIQUIDIFICADOR
INITIAL_VOLTAGE=121.0

# ---------------------------------------------------------------------------
# Middleware
# ---------------------------------------------------------------------------
# CLP alvo. Em desenvolvimento, o simulador na mesma maquina:
MODBUS_HOST=127.0.0.1
MODBUS_PORT=5020
MODBUS_UNIT_ID=1
MODBUS_TIMEOUT=3.0

# CLP real (producao) - trocar apenas estas tres linhas:
# MODBUS_HOST=<IP_DO_CLP_REAL>
# MODBUS_PORT=502
# MODBUS_UNIT_ID=<UNIT_ID>

POLL_INTERVAL=1.0
RECONNECT_DELAY=3.0
APPLICATION_BASE_URL=http://localhost:8000
MIDDLEWARE_API_HOST=0.0.0.0
MIDDLEWARE_API_PORT=8090

# ---------------------------------------------------------------------------
# Comuns aos dois
# ---------------------------------------------------------------------------
MODBUS_MAP_PATH=config/modbus_map.yaml
INTEGRATION_CONFIG_PATH=config/integration.yaml
LOG_LEVEL=INFO
