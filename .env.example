# ---------------------------------------------------------------------------
# Simulador de CLP
# ---------------------------------------------------------------------------
MODBUS_HOST=0.0.0.0
MODBUS_PORT=5020
WEB_HOST=0.0.0.0
WEB_PORT=8080
MODBUS_MAP_PATH=config/modbus_map.yaml
SIMULATOR_TITLE=TESTE LIQUIDIFICADOR
INITIAL_VOLTAGE=121.0

# ---------------------------------------------------------------------------
# Middleware
# ---------------------------------------------------------------------------
# CLP virtual (desenvolvimento):
MIDDLEWARE_MODBUS_HOST=127.0.0.1
MIDDLEWARE_MODBUS_PORT=5020
MIDDLEWARE_MODBUS_UNIT_ID=1

# CLP real (producao) - trocar apenas estas tres linhas:
# MIDDLEWARE_MODBUS_HOST=<IP_DO_CLP_REAL>
# MIDDLEWARE_MODBUS_PORT=502
# MIDDLEWARE_MODBUS_UNIT_ID=<UNIT_ID>

POLL_INTERVAL=1.0
APPLICATION_BASE_URL=http://localhost:8000
MIDDLEWARE_API_PORT=8090
INTEGRATION_CONFIG_PATH=config/integration.yaml
LOG_LEVEL=INFO
